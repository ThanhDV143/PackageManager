@* Wraps admin pages: guests get a short explanation and a login link instead. *@
@inject AuthState Auth
@inject NavigationManager Nav

@if (Auth.IsAdmin)
{
    @ChildContent
}
else
{
    <main class="page page--narrow">
        <EmptyState Title="Trang này dành cho admin" IconName="alert">
            <Actions>
                <a class="btn btn--primary" href="@($"login?returnUrl={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}")">Đăng nhập</a>
            </Actions>
        </EmptyState>
    </main>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
