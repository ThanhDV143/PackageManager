@if (Total > 0)
{
    <nav aria-label="Phân trang" class="pager">
        <span>Hiển thị @From–@To trong @Total @Noun</span>
        @if (Pages > 1)
        {
            <div class="pager__btns">
                <button type="button" aria-label="Trang trước" disabled="@(Page <= 1)" @onclick="() => Go(Page - 1)">‹</button>
                @foreach (int p in Visible())
                {
                    if (p < 0)
                    {
                        <span style="align-self: center; padding: 0 4px">…</span>
                    }
                    else
                    {
                        int target = p;
                        <button type="button" aria-current="@(p == Page ? "page" : null)" @onclick="() => Go(target)">@p</button>
                    }
                }
                <button type="button" aria-label="Trang sau" disabled="@(Page >= Pages)" @onclick="() => Go(Page + 1)">›</button>
            </div>
        }
    </nav>
}

@code {
    [Parameter] public int Page { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public int Total { get; set; }
    [Parameter] public string Noun { get; set; } = "package";
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    private int Pages => (int)Math.Ceiling(Total / (double)PageSize);
    private int From => (Page - 1) * PageSize + 1;
    private int To => Math.Min(Page * PageSize, Total);

    private Task Go(int page) => PageChanged.InvokeAsync(Math.Clamp(page, 1, Pages));

    /// <summary>1 … 4 5 6 … 12 — negative numbers mark gaps.</summary>
    private IEnumerable<int> Visible()
    {
        if (Pages <= 7)
        {
            for (int i = 1; i <= Pages; i++) yield return i;
            yield break;
        }
        int start = Math.Max(2, Page - 1), end = Math.Min(Pages - 1, Page + 1);
        yield return 1;
        if (start > 2) yield return -1;
        for (int i = start; i <= end; i++) yield return i;
        if (end < Pages - 1) yield return -2;
        yield return Pages;
    }
}
