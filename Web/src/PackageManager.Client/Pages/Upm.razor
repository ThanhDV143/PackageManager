@page "/upm"
@inject Api Api
@inject UpmStatus Status
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>UPM · Package Manager</PageTitle>

<main class="page">
    <div class="page-head">
        <div class="page-head__text">
            <h1 class="page-title">UPM</h1>
            <p class="page-sub">@(_data?.Packages.Count ?? 0) package từ Verdaccio</p>
        </div>
        <label class="select-pill">
            Sắp xếp
            <select @bind="_sort">
                <option value="updated">Mới cập nhật</option>
                <option value="name">Tên A–Z</option>
            </select>
        </label>
    </div>

    <div class="upm-banner">
        <span class="upm-banner__icon"><Icon Name="server" /></span>
        <div class="upm-banner__text">
            <span style="font-weight: 600">Registry: <span class="mono" style="color: var(--upm-text)">@(_data?.Registry ?? "…")</span></span>
        </div>
        <button type="button" class="btn btn--upm" disabled="@(_data == null)" @onclick="CopyUrl"><Icon Name="copy" Size="16" />Copy URL</button>
    </div>

    @if (_data == null)
    {
        <div class="list-box">
            @for (int i = 0; i < 5; i++)
            {
                <div class="upm-row">
                    <span class="sk" style="width: 44px; height: 44px; border-radius: 12px"></span>
                    <div class="upm-row__main" style="gap: 8px">
                        <span class="sk" style="height: 14px; width: 35%"></span>
                        <span class="sk sk--soft" style="height: 10px; width: 70%"></span>
                    </div>
                </div>
            }
        </div>
    }
    else if (!_data.Available)
    {
        <div class="error-panel">
            <span class="empty__icon"><Icon Name="unplug" Size="26" /></span>
            <span class="empty__title">Không kết nối được registry UPM</span>
            <span class="empty__text"><span class="mono">@Host</span> không phản hồi.</span>
            <button type="button" class="btn btn--danger" @onclick="LoadAsync"><Icon Name="refresh" />Thử lại</button>
        </div>
    }
    else if (_data.Packages.Count == 0)
    {
        <EmptyState Title="Registry chưa có package nào" IconName="upm">
        </EmptyState>
    }
    else
    {
        <div class="list-box">
            @foreach (var p in Sorted)
            {
                <a href="@($"upm/{Uri.EscapeDataString(p.Name)}")" class="upm-row">
                    <span class="upm-icon"><Icon Name="upm" Size="22" /></span>
                    <div class="upm-row__main">
                        <div class="row" style="align-items: baseline; gap: 4px 10px">
                            <span style="font-weight: 600; font-size: 16px; color: var(--text)">@(p.DisplayName ?? p.Name)</span>
                            <span class="mono small subtle">@(p.DisplayName != null ? p.Name : "không có displayName → dùng tên package")</span>
                        </div>
                        <p class="clamp-2" style="margin: 0; color: var(--muted); line-height: 1.5" title="@p.Description">@(string.IsNullOrWhiteSpace(p.Description) ? "Không có mô tả." : p.Description)</p>
                        @if (p.Keywords.Count > 0)
                        {
                            <div class="row" style="gap: 6px; padding-top: 2px">
                                @foreach (var k in p.Keywords)
                                {
                                    <span class="chip chip--keyword">@k</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="upm-row__side">
                        <span class="ver-tag ver-tag--upm">@p.Version</span>
                        @if (p.Author != null)
                        {
                            <span class="xsmall subtle">@p.Author</span>
                        }
                        <span class="xsmall subtle">Cập nhật @Fmt.Date(p.UpdatedAt)</span>
                    </div>
                </a>
            }
        </div>
    }
</main>

@code {
    private UpmListDto? _data;
    private string _sort = "updated";

    private string Host => Uri.TryCreate(_data?.Registry, UriKind.Absolute, out var u) ? u.Host : "Registry";

    private IEnumerable<UpmPackageSummaryDto> Sorted => _sort == "name"
        ? _data!.Packages.OrderBy(p => p.DisplayName ?? p.Name, StringComparer.CurrentCultureIgnoreCase)
        : _data!.Packages.OrderByDescending(p => p.UpdatedAt);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _data = null;
        try { _data = await Api.ListUpm(); }
        catch (ApiException) { _data = new UpmListDto { Available = false }; }
        Status.Report(_data.Available);
    }

    private async Task CopyUrl()
    {
        if (await JS.InvokeAsync<bool>("pm.copy", _data!.Registry)) Snackbar.Add("Đã copy URL registry", Severity.Normal);
    }
}
