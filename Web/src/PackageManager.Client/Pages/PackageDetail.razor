@page "/packages/{PackageId}"
@inject Api Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@(_pkg?.DisplayName ?? "Package") · Package Manager</PageTitle>

<main class="page page--detail">
    <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="">.unitypackage</a>
        <Icon Name="chevron-right" Size="14" />
        <span aria-current="page">@(_pkg?.DisplayName ?? PackageId)</span>
    </nav>

    @if (_notFound)
    {
        <EmptyState Title="Không tìm thấy package" IconName="box" IconClass="empty__icon--unity">
            <ChildContent>Package <code>@PackageId</code> không tồn tại hoặc đã bị xoá.</ChildContent>
            <Actions><a href="" class="btn btn--neutral">Về danh sách</a></Actions>
        </EmptyState>
    }
    else if (_error != null)
    {
        <div class="error-panel">
            <span class="empty__icon"><Icon Name="alert" Size="26" /></span>
            <span class="empty__title">Không tải được package</span>
            <span class="empty__text">@_error</span>
            <button type="button" class="btn btn--danger" @onclick="LoadAsync"><Icon Name="refresh" />Thử lại</button>
        </div>
    }
    else if (_pkg == null)
    {
        <section class="hero">
            <div class="hero__media"><div class="thumb sk" style="border-radius: 0"></div></div>
            <div class="hero__info">
                <span class="sk" style="height: 22px; width: 220px; border-radius: 99px"></span>
                <span class="sk" style="height: 40px; width: 50%"></span>
                <span class="sk sk--soft" style="height: 14px; width: 30%"></span>
                <span class="sk sk--soft" style="height: 14px; width: 90%"></span>
                <span class="sk sk--soft" style="height: 48px; width: 280px; border-radius: 12px"></span>
            </div>
        </section>
    }
    else
    {
        var latest = _pkg.Versions.FirstOrDefault(v => v.IsLatest);
        <section class="hero">
            <div class="hero__media"><PackageImage Url="@_pkg.MainImageUrl" Name="@_pkg.DisplayName" /></div>
            <div class="hero__info">
                <div class="row" style="gap: 6px">
                    <span class="chip chip--unity"><Icon Name="box" Size="13" Stroke="2.2" />unitypackage</span>
                    @if (!string.IsNullOrEmpty(_pkg.Category))
                    {
                        <span class="chip chip--neutral">@_pkg.Category</span>
                    }
                </div>
                <h1 class="hero__title">@_pkg.DisplayName</h1>
                @if (!string.IsNullOrEmpty(_pkg.Publisher))
                {
                    <div class="hero__by">bởi <strong>@_pkg.Publisher</strong></div>
                }
                @if (!string.IsNullOrEmpty(_pkg.ShortDescription))
                {
                    <p class="hero__desc">@_pkg.ShortDescription</p>
                }
                <div class="row desktop-only" style="gap: 10px; padding-top: 6px">
                    @if (latest != null)
                    {
                        <a href="@Api.VersionDownloadUrl(latest.Id)" download class="btn btn--primary btn--lg">
                            <Icon Name="download" Size="20" Stroke="2.2" />Tải bản mới nhất<span class="meta">v@(latest.Version) · @Fmt.Size(latest.Size)</span>
                        </a>
                    }
                    else
                    {
                        <span class="btn btn--neutral btn--lg" aria-disabled="true">Chưa có file</span>
                    }
                    @if (!string.IsNullOrEmpty(_pkg.AssetStoreUrl))
                    {
                        <a href="@_pkg.AssetStoreUrl" target="_blank" rel="noopener noreferrer" class="btn btn--neutral btn--lg" style="font-size: 14px">Xem trên Asset Store<Icon Name="external" Size="16" /></a>
                    }
                </div>
                @if (Auth.IsAdmin)
                {
                    <div class="admin-bar">
                        <span class="admin-bar__label">Admin</span>
                        <button type="button" class="btn btn--ghost" @onclick="Edit"><Icon Name="edit" Size="16" />Sửa</button>
                        <a href="@($"admin/upload?package={Uri.EscapeDataString(_pkg.PackageId)}")" class="btn btn--ghost"><Icon Name="plus" Size="16" />Thêm phiên bản</a>
                        @if (!string.IsNullOrEmpty(_pkg.AssetStoreUrl))
                        {
                            <button type="button" class="btn btn--ghost" disabled="@_refreshing" @onclick="Refresh"><Icon Name="refresh" Size="16" />Làm mới từ Asset Store</button>
                        }
                        <button type="button" class="btn btn--ghost" style="color: var(--error)" @onclick="DeletePackage"><Icon Name="trash" Size="16" />Xoá</button>
                    </div>
                }
            </div>
        </section>

        <section aria-labelledby="ver-h" style="display: flex; flex-direction: column; gap: 14px">
            <div class="row" style="align-items: baseline; gap: 10px">
                <h2 id="ver-h" class="section-title">Phiên bản</h2>
                <span class="small subtle">@_pkg.Versions.Count file</span>
            </div>
            @if (_pkg.Versions.Count == 0)
            {
                <EmptyState Title="Chưa có file nào" IconName="file">
                    <Actions>
                        @if (Auth.IsAdmin)
                        {
                            <div class="row" style="justify-content: center">
                                <a href="@($"admin/upload?package={Uri.EscapeDataString(_pkg.PackageId)}")" class="btn btn--primary">Upload</a>
                                <a href="admin/unmanaged" class="btn btn--neutral">File chưa quản lý</a>
                            </div>
                        }
                    </Actions>
                </EmptyState>
            }
            else
            {
                <div class="table-wrap desktop-only">
                    <div class="t-versions">
                        <div class="t-head"><span></span><span>Phiên bản</span><span>Tên file</span><span>Dung lượng</span><span>Unity</span><span>Ngày upload</span><span style="text-align: right">Thao tác</span></div>
                        @foreach (var v in _pkg.Versions)
                        {
                            bool open = _expanded.Contains(v.Id);
                            <div class="t-row">
                                @if (!string.IsNullOrWhiteSpace(v.ReleaseNotes))
                                {
                                    <button type="button" class="expand-btn" aria-expanded="@(open ? "true" : "false")"
                                            aria-label="@(open ? "Thu gọn" : "Mở") release notes @v.Version" @onclick="() => Toggle(v.Id)">
                                        <Icon Name="chevron-down" Size="16" />
                                    </button>
                                }
                                else
                                {
                                    <span></span>
                                }
                                <span class="row" style="gap: 8px; flex-wrap: nowrap">
                                    <span class="ver-num @(v.IsLatest ? "ver-num--latest" : null)">@v.Version</span>
                                    @if (v.IsLatest)
                                    {
                                        <span class="latest-badge">Mới nhất</span>
                                    }
                                </span>
                                <span class="mono small ellipsis" style="color: var(--text-2)" title="@v.FileName">@v.FileName</span>
                                <span class="muted">@Fmt.Size(v.Size)</span>
                                <span class="@(v.UnityVersion == null ? "subtle" : "muted")">@(v.UnityVersion ?? "—")</span>
                                <span class="muted">@Fmt.Date(v.UploadedAt)</span>
                                <div class="t-actions">
                                    <a href="@Api.VersionDownloadUrl(v.Id)" download aria-label="Tải phiên bản @v.Version"
                                       class="btn-icon @(v.IsLatest ? "btn-icon--primary" : "btn-icon--outline")"><Icon Name="download" Stroke="2.2" /></a>
                                    @if (Auth.IsAdmin)
                                    {
                                        <button type="button" class="btn-icon btn-icon--danger" aria-label="Xoá phiên bản @v.Version" @onclick="() => DeleteVersion(v)"><Icon Name="trash" /></button>
                                    }
                                </div>
                            </div>
                            @if (open)
                            {
                                <div class="release-notes"><strong>Release notes</strong> · @v.ReleaseNotes</div>
                            }
                        }
                    </div>
                </div>

                <div class="mobile-only" style="flex-direction: column; gap: 8px">
                    @foreach (var v in _pkg.Versions)
                    {
                        <div class="m-item" style="padding: 10px 12px">
                            <span style="flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0">
                                <span class="row" style="gap: 8px">
                                    <span class="mono" style="font-weight: 600; color: @(v.IsLatest ? "var(--unity-text)" : "var(--text-2)")">@v.Version</span>
                                    @if (v.IsLatest)
                                    {
                                        <span class="latest-badge" style="font-size: 10px; padding: 1px 7px">Mới nhất</span>
                                    }
                                </span>
                                <span class="xsmall subtle">@Fmt.Size(v.Size) · @Fmt.Date(v.UploadedAt)</span>
                            </span>
                            <a href="@Api.VersionDownloadUrl(v.Id)" download aria-label="Tải @v.Version" class="btn-icon btn-icon--outline btn-icon--lg"><Icon Name="download" Stroke="2.2" /></a>
                        </div>
                    }
                </div>
            }
        </section>

        @if (_pkg.Media.Count > 0)
        {
            <section aria-labelledby="shot-h" style="display: flex; flex-direction: column; gap: 14px">
                <h2 id="shot-h" class="section-title">Ảnh chụp màn hình</h2>
                <div class="media-strip">
                    @for (int i = 0; i < _pkg.Media.Count; i++)
                    {
                        var m = _pkg.Media[i];
                        int index = i;
                        <button type="button" class="media-tile" aria-label="@(m.Type == "youtube" ? "Xem video giới thiệu" : $"Ảnh chụp {i + 1}")" @onclick="() => _lightbox = index">
                            @if ((m.ThumbnailUrl ?? (m.Type == "youtube" ? null : m.Url)) is { } src)
                            {
                                <img src="@src" alt="" loading="lazy" />
                            }
                            @if (m.Type == "youtube")
                            {
                                <span class="media-tile__play"><Icon Name="play" /></span>
                            }
                        </button>
                    }
                </div>
            </section>
        }

        <div class="split">
            <section aria-labelledby="desc-h" class="split__main">
                <h2 id="desc-h" class="section-title">Mô tả</h2>
                @if (string.IsNullOrWhiteSpace(_pkg.DescriptionHtml))
                {
                    <div class="rich" style="color: var(--subtle)">Chưa có mô tả đầy đủ.</div>
                }
                else
                {
                    <div class="rich @(_descExpanded ? null : "collapsed")" @ref="_descEl">@((MarkupString)_pkg.DescriptionHtml)</div>
                    @if (_descOverflows)
                    {
                        <button type="button" class="btn btn--neutral" style="align-self: flex-start" aria-expanded="@(_descExpanded ? "true" : "false")"
                                @onclick="() => _descExpanded = !_descExpanded">
                            @(_descExpanded ? "Thu gọn mô tả" : "Hiện toàn bộ mô tả")
                            <Icon Name="chevron-down" Size="16" Class="@(_descExpanded ? "flip" : null)" />
                        </button>
                    }
                }
            </section>

            <aside aria-labelledby="info-h" class="split__side">
                <h2 id="info-h" class="section-title">Thông tin</h2>
                <dl class="info-list">
                    <div><dt>ID</dt><dd class="mono small">@_pkg.PackageId</dd></div>
                    <div><dt>Publisher</dt><dd>@(_pkg.Publisher ?? "—")</dd></div>
                    <div><dt>Category</dt><dd>@(_pkg.Category ?? "—")</dd></div>
                    <div><dt>Unity hỗ trợ</dt><dd>@(_pkg.UnityVersion ?? "—")</dd></div>
                    @if (!string.IsNullOrEmpty(_pkg.StoreVersion))
                    {
                        <div>
                            <dt>Bản trên Store</dt>
                            <dd style="display: flex; flex-direction: column; align-items: flex-end; gap: 2px">
                                <span class="mono small">@_pkg.StoreVersion</span>
                            </dd>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_pkg.AssetStoreUrl))
                    {
                        <div><dt>Asset Store</dt><dd><a href="@_pkg.AssetStoreUrl" target="_blank" rel="noopener noreferrer" style="color: var(--primary-text)">@(_pkg.AssetStoreSlug ?? "Mở")</a></dd></div>
                    }
                </dl>
                @if (_pkg.MetadataFetchedAt is { } fetched)
                {
                    <p class="xsmall subtle" style="margin: 0">Metadata đọc từ Asset Store lần cuối @Fmt.Date(fetched)</p>
                }
            </aside>
        </div>

        @if (latest != null)
        {
            <div class="mobile-dl-bar">
                <a href="@Api.VersionDownloadUrl(latest.Id)" download class="btn btn--primary btn--block" style="height: 52px; border-radius: 14px; font-size: 15px">
                    <Icon Name="download" Stroke="2.2" />Tải v@(latest.Version) · @Fmt.Size(latest.Size)
                </a>
            </div>
        }
    }
</main>

@if (_lightbox is { } li && _pkg != null && li < _pkg.Media.Count)
{
    var item = _pkg.Media[li];
    <div class="lightbox" role="dialog" aria-modal="true" aria-label="Ảnh chụp màn hình" @onclick="() => _lightbox = null" @onkeydown="LightboxKey" tabindex="-1" @ref="_lightboxEl">
        <button type="button" class="icon-btn" style="top: 8px; right: 8px" aria-label="Đóng" @onclick="() => _lightbox = null"><Icon Name="close" Size="22" /></button>
        @if (_pkg.Media.Count > 1)
        {
            <button type="button" class="icon-btn" style="left: 8px; top: 50%" aria-label="Ảnh trước" @onclick="() => Step(-1)" @onclick:stopPropagation><Icon Name="arrow-left" Size="22" /></button>
            <button type="button" class="icon-btn" style="right: 8px; top: 50%; transform: scaleX(-1)" aria-label="Ảnh sau" @onclick="() => Step(1)" @onclick:stopPropagation><Icon Name="arrow-left" Size="22" /></button>
        }
        <div class="lightbox__frame" @onclick:stopPropagation>
            @if (item.Type == "youtube")
            {
                <iframe src="@YouTube(item.Url)" title="Video giới thiệu" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
            }
            else
            {
                <img src="@item.Url" alt="Ảnh chụp @(li + 1)" />
            }
        </div>
    </div>
}

@code {
    [Parameter] public string PackageId { get; set; } = "";

    private PackageDetailDto? _pkg;
    private string? _error;
    private bool _notFound, _refreshing, _descExpanded, _descOverflows, _measureDesc;
    private readonly HashSet<int> _expanded = [];
    private ElementReference _descEl, _lightboxEl;
    private int? _lightbox;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        _notFound = false;
        try
        {
            _pkg = await Api.GetPackage(PackageId);
            _notFound = _pkg == null;
            _expanded.Clear();
            var latest = _pkg?.Versions.FirstOrDefault(v => v.IsLatest);
            if (latest is { ReleaseNotes.Length: > 0 }) _expanded.Add(latest.Id);
            _descExpanded = false;
            _measureDesc = true;
        }
        catch (ApiException ex) { _error = ex.Message; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_measureDesc && _pkg?.DescriptionHtml != null)
        {
            _measureDesc = false;
            _descOverflows = await JS.InvokeAsync<bool>("pm.isOverflowing", _descEl);
            if (_descOverflows) StateHasChanged();
        }
        if (_lightbox != null) await _lightboxEl.FocusAsync();
    }

    private void Toggle(int id)
    {
        if (!_expanded.Remove(id)) _expanded.Add(id);
    }

    private void Step(int delta)
    {
        if (_pkg == null || _lightbox is not { } i) return;
        _lightbox = (i + delta + _pkg.Media.Count) % _pkg.Media.Count;
    }

    private void LightboxKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _lightbox = null;
        else if (e.Key == "ArrowLeft") Step(-1);
        else if (e.Key == "ArrowRight") Step(1);
    }

    private static string YouTube(string url) => url.Contains('?') ? url + "&autoplay=1" : url + "?autoplay=1";

    private async Task Edit()
    {
        if (_pkg == null) return;
        if (await PackageDialog.OpenAsync(Dialogs, _pkg) is not { } saved) return;
        Snackbar.Add($"Đã lưu {saved.DisplayName}", Severity.Normal);
        if (saved.PackageId != PackageId) Nav.NavigateTo("packages/" + Uri.EscapeDataString(saved.PackageId), replace: true);
        else { _pkg = saved; _measureDesc = true; }
    }

    private async Task Refresh()
    {
        _refreshing = true;
        try
        {
            _pkg = await Api.RefreshPackage(PackageId);
            _measureDesc = true;
            Snackbar.Add("Đã làm mới metadata từ Asset Store", Severity.Normal);
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _refreshing = false; }
    }

    private async Task DeleteVersion(PackageVersionDto v)
    {
        var choice = await ConfirmDialog.ShowAsync(Dialogs, $"Xoá phiên bản {v.Version}?",
            $"Phiên bản {v.Version} ({v.FileName}) sẽ bị gỡ khỏi package.", "Xoá phiên bản",
            checkboxLabel: "Xoá luôn file trên ổ đĩa", isChecked: true);
        if (choice is not { } deleteFile) return;
        try
        {
            await Api.DeleteVersion(v.Id, deleteFile);
            Snackbar.Add($"Đã xoá phiên bản {v.Version}", Severity.Normal);
            await LoadAsync();
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task DeletePackage()
    {
        if (_pkg == null) return;
        var choice = await ConfirmDialog.ShowAsync(Dialogs, "Xoá package?",
            $"Xoá \"{_pkg.DisplayName}\" cùng {_pkg.Versions.Count} phiên bản khỏi danh sách.", "Xoá package",
            checkboxLabel: "Xoá luôn file trên ổ đĩa");
        if (choice is not { } deleteFiles) return;
        try
        {
            await Api.DeletePackage(_pkg.PackageId, deleteFiles);
            Snackbar.Add($"Đã xoá {_pkg.DisplayName}", Severity.Normal);
            Nav.NavigateTo("");
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
